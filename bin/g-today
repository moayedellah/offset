#!/bin/sh
# bin/g-today — render the pull-based daily ritual.
#
# Pull only. It never notifies, never schedules, and never writes any file other
# than today.md. If it started pushing, a system that interrupts you would be
# manufacturing attention residue inside the exact activity where you are
# trying to hold attention (rules/03-agent-contract.md §6).

set -u
G_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$G_DIR/lib.sh"

usage() {
    cat <<'USAGE'
g-today — regenerate <vault>/today.md from the due set

  g-today <vault> [--print]

Deterministic: the same vault state produces byte-identical output.
USAGE
}

[ $# -ge 1 ] || { usage >&2; exit 2; }
VAULT="$1"; shift
PRINT=0
while [ $# -gt 0 ]; do
    case "$1" in
        --print) PRINT=1; shift ;;
        -h|--help) usage; exit 0 ;;
        *) printf 'g-today: unknown argument %s\n' "$1" >&2; exit 2 ;;
    esac
done

[ -d "$VAULT" ] || { printf 'g-today: no such vault: %s\n' "$VAULT" >&2; exit 1; }

TODAY=$(g_today_iso)
LIST=$(mktemp "${TMPDIR:-/tmp}/g-today.XXXXXX") || exit 1
OUT=$(mktemp "${TMPDIR:-/tmp}/g-today-out.XXXXXX") || exit 1
trap 'rm -f "$LIST" "$OUT"' EXIT INT TERM

find "$VAULT" -name '*.md' -not -path '*/.git/*' -not -path '*/raw/*' 2>/dev/null \
    | LC_ALL=C sort > "$LIST"

due_rows=""
overdue_rows=""
flight_rows=""
counts_due=0; counts_over=0; counts_flight=0
suggest=""

emit_row() {
    printf -- '- `%s` — %s _(state: %s, due %s)_\n' "$1" "$2" "$3" "$4"
}

while IFS= read -r f; do
    [ -n "$f" ] || continue
    g_has_frontmatter "$f" || continue
    t=$(g_fm_get "$f" type)
    case "$t" in claim|practice) ;; *) continue ;; esac
    id=$(g_fm_get "$f" id)
    title=$(g_fm_get "$f" title)
    state=$(g_fm_get "$f" state)
    d=$(g_fm_getn "$f" due)
    [ -n "$d" ] || continue

    if [ "$(g_days_between "$d" "$TODAY")" -ge 0 ]; then
        counts_due=$((counts_due + 1))
        due_rows="${due_rows}$(emit_row "$id" "$title" "$state" "$d")"
        continue
    fi

    counts_over=$((counts_over + 1))
    overdue_rows="${overdue_rows}$(emit_row "$id" "$title" "$state" "$d")"

    # The oldest overdue item is the suggested next step: the ladder exists to
    # resurface things at the moment they are about to be lost, so the most
    # overdue thing is the most at risk.
    if [ -z "$suggest" ]; then
        suggest="- \`$id\` — $title (overdue since $d)"
    fi
done < "$LIST"

# In flight: recorded failures are the ones the Closed Book has opened.
while IFS= read -r f; do
    [ -n "$f" ] || continue
    g_has_frontmatter "$f" || continue
    [ "$(g_fm_get "$f" type)" = "claim" ] || continue
    st=$(g_fm_get "$f" state)
    case "$st" in failed|re-attempting) ;; *) continue ;; esac
    counts_flight=$((counts_flight + 1))
    id=$(g_fm_get "$f" id)
    flight_rows="${flight_rows}- \`$id\` — $(g_fm_get "$f" title) _(state: $st — the Closed Book is open)_\n"
done < "$LIST"

{
    printf -- '---\n'
    printf 'type: today\n'
    printf -- '---\n\n'
    printf '# today — %s\n\n' "$TODAY"
    printf 'Generated by `bin/g-today`. Pull-based: nothing was scheduled, nothing was sent.\n\n'

    printf '## overdue\n\n'
    if [ "$counts_over" -eq 0 ]; then
        printf 'Nothing overdue. The ladder is keeping up.\n\n'
    else
        printf '%s claims are past due. Lint rule L6 fails the build on these until\n' "$counts_over"
        printf '`bin/g-schedule` moves them forward.\n\n'
        printf '%s\n\n' "$overdue_rows"
    fi

    printf '## due now\n\n'
    if [ "$counts_due" -eq 0 ]; then
        printf 'Nothing due. The rack is quiet.\n\n'
    else
        printf '%s claims and practices are due or later.\n\n' "$counts_due"
    fi

    printf '## in flight\n\n'
    if [ "$counts_flight" -eq 0 ]; then
        printf 'Nothing in flight.\n\n'
    else
        printf 'Recorded failures, and therefore claims whose answer sheet is open.\n\n'
        printf '%b\n\n' "$flight_rows"
    fi

    printf '## one suggested next step\n\n'
    if [ -n "$suggest" ]; then
        printf '%s\n\n' "$suggest"
    else
        printf 'Nothing to pull. Open a new source, or revisit a claim you marked `failed` —\n'
        printf 'that is where the Closed Book does its work.\n\n'
    fi

    printf -- '---\n\n'
    printf 'Reminder for the agent: do not open a ritual session uninvited, and never\n'
    printf 'surface anything from this file mid-task (rules/03-agent-contract.md §6).\n'
} > "$OUT"

if [ "$PRINT" -eq 1 ]; then
    cat "$OUT"
else
    cp "$OUT" "$VAULT/today.md" || { printf 'g-today: cannot write %s/today.md\n' "$VAULT" >&2; exit 1; }
    printf '%s/today.md\n' "$VAULT"
fi
exit 0
